# Optional: your canonical public origin, including https:// and no path.
# Set this in Vercel's Production environment after adding a custom domain.
# Changing it requires a new deployment because pages are rendered at build time.
# SITE_URL=https://your-kumo-domain.be

# Without SITE_URL, Vercel's VERCEL_PROJECT_PRODUCTION_URL is used,
# then VERCEL_URL. Local development defaults to http://localhost:3000.
# No secrets or other environment variables are required.
